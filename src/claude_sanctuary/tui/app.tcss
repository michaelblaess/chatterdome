Screen {
    layout: vertical;
}

#kopf {
    height: auto;
}

#bereiche {
    height: 4fr;
    min-height: 12;
}

#bereiche TabPane {
    padding: 0 1;
}

/* -- Agenten-Bereich: 60 zu 40, per Splitter verschiebbar -- */

#agenten-raum {
    height: 1fr;
    layout: horizontal;
}

#agenten {
    width: 60%;
    height: 1fr;
}

/* Keine eigene height-Vorgabe fuer die Suchleiste: sie rendert drei Zeilen
   (Rahmen, Icon plus Eingabe, Rahmen). Wird die Hoehe gesetzt, quetscht es
   die innere Zeile zusammen und das Feld ist unsichtbar. */
#agenten SearchInputWithHistory {
    padding: 0 1;
}

#agenten #agenten-daten {
    height: 1fr;
}

#verlauf-raum {
    width: 1fr;
    height: 1fr;
}

#verlauf {
    height: 3fr;
    min-height: 5;
    padding: 0 1;
    background: $surface;
}

#eingabe-raum {
    height: auto;
    min-height: 6;
}

#eingabe {
    width: 1fr;
}

#senden {
    width: auto;
    margin: 1 0 0 0;
}

/* -- Verlaufsblasen -- */

.blase {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
}

.blase.eigen {
    background: $primary 25%;
    margin-left: 8;
    border-left: solid $primary;
}

.blase.fremd {
    background: $panel;
    margin-right: 8;
    border-left: solid $accent;
}

.verlauf-hinweis {
    height: auto;
    padding: 1 2;
    color: $text-muted;
    text-style: italic;
}

.platzhalter {
    height: auto;
    padding: 2;
    color: $text-muted;
    text-style: italic;
}

/* -- Statuszeile: eine Zeile Inhalt, also height 1 -- */

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

/* -- Log-Panel: standardmaessig sichtbar -- */

#log {
    height: 1fr;
    min-height: 5;
    max-height: 30;
    background: $surface;
}
