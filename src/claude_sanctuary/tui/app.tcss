Screen {
    layout: vertical;
}

#kopf {
    height: auto;
}

#bereiche {
    height: 4fr;
    min-height: 12;
}

#bereiche TabPane {
    padding: 0 1;
}

/* -- Agenten-Bereich: 60 zu 40, per Splitter verschiebbar -- */

#agenten-raum {
    height: 1fr;
    layout: horizontal;
}

#agenten {
    width: 60%;
    height: 1fr;
}

/* Keine eigene height-Vorgabe fuer die Suchleiste: sie rendert drei Zeilen
   (Rahmen, Icon plus Eingabe, Rahmen). Wird die Hoehe gesetzt, quetscht es
   die innere Zeile zusammen und das Feld ist unsichtbar. */
#agenten SearchInputWithHistory {
    padding: 0 1;
}

#agenten #agenten-daten {
    height: 1fr;
}

#verlauf-raum {
    width: 1fr;
    height: 1fr;
}

#verlauf {
    height: 3fr;
    min-height: 5;
    padding: 0 1;
    background: $surface;
}

#eingabe-raum {
    height: auto;
    min-height: 6;
}

/* Breite und Knopfgroesse bringt ClearableInput selbst mit. */

#schnellbefehle {
    height: auto;
    margin: 1 0 0 0;
}

#schnellbefehle Button {
    width: auto;
    margin: 0 1 0 0;
}

/* Die vorformulierten Texte treten hinter den Senden-Knopf zurueck. */
#schnellbefehle .schnell {
    color: $text-muted;
}

/* -- Verlaufsblasen -- */

.blase {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
}

.blase.eigen {
    background: $primary 25%;
    margin-left: 8;
    border-left: solid $primary;
}

.blase.fremd {
    background: $panel;
    margin-right: 8;
    border-left: solid $accent;
}

.verlauf-hinweis {
    height: auto;
    padding: 1 2;
    color: $text-muted;
    text-style: italic;
}

.platzhalter {
    height: auto;
    padding: 2;
    color: $text-muted;
    text-style: italic;
}

/* Die Statuszeile bringt Rahmen und Trenner selbst mit (StatusBar). */

/* -- Log-Panel: standardmaessig sichtbar -- */

#log {
    height: 1fr;
    min-height: 5;
    max-height: 30;
    background: $surface;
}

/* -- Gedaechtnis-Tab ---------------------------------------------------- */

#gedaechtnis-raum {
    height: 1fr;
    layout: horizontal;
}

#notizen {
    width: 62%;
    height: 1fr;
}

/* Wie bei der Agententabelle: die Suchleiste braucht ihre drei Zeilen,
   eine Hoehenvorgabe wuerde das Feld zerquetschen. */
#notizen SearchInputWithHistory {
    padding: 0 1;
}

#notizen #notizen-daten {
    height: 1fr;
}

#gedaechtnis-detail {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    background: $surface;
}

#gedaechtnis-inhalt {
    height: auto;
}

/* ---- Message-Bus ------------------------------------------------- */

#bus-raum {
    height: 1fr;
    layout: horizontal;
}

#bus-liste {
    width: 64%;
    height: 1fr;
}

/* Die drei Auswahlfelder nebeneinander. height: auto, sonst zieht die
   Zeile sich auf die halbe Tabelle. */
#bus-filter {
    height: auto;
    padding: 0 1;
}

#bus-filter Select {
    width: 1fr;
    margin: 0 1 0 0;
}

/* Wie bei der Agententabelle: die Suchleiste braucht ihre drei Zeilen,
   eine Hoehenvorgabe wuerde das Feld zerquetschen. */
#bus-liste SearchInputWithHistory {
    padding: 0 1;
}

#bus-liste #bus-daten {
    height: 1fr;
}

#bus-leer {
    padding: 1 2;
    color: $text-muted;
}

#bus-detail {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    background: $surface;
}

#bus-inhalt {
    height: auto;
}
